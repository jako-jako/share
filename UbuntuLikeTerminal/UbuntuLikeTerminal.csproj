<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>UbuntuLikeTerminal</RootNamespace>
    <AssemblyName>UbuntuLikeTerminal</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- Console apps need this so Console.ReadKey / redirected-input edge cases behave predictably -->
    <StartupObject>UbuntuLikeTerminal.Program</StartupObject>
  </PropertyGroup>

</Project>
